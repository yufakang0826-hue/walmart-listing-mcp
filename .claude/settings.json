{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-post-edit.mjs",
            "timeout": 60,
            "statusMessage": "Rebuilding + running structural smoke",
            "async": true
          }
        ]
      }
    ]
  }
}
