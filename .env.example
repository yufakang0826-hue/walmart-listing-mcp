# Walmart Marketplace API credentials.
# SECURITY: never commit this file with real values. .env is already
# gitignored. For multi-profile setups, prefer using the
# walmart_upsert_seller_profile MCP tool instead of env vars so credentials
# live in .walmart-seller-profiles.json (also gitignored).
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
WALMART_MARKETPLACE=US
WALMART_SANDBOX=false

# Consumer ID (WM_CONSUMER.ID) from Walmart Developer Portal.
# Required by Walmart routing layer — feeds fail with "Mandatory routing headers must be present" without it.
WALMART_CONSUMER_ID=

# Consumer Channel Type UUID (WM_CONSUMER.CHANNEL.TYPE) from Walmart Developer Portal.
# Needed so feeds are tagged as SELLER_API source.
WALMART_CHANNEL_TYPE=

# WM_SVC.ENV value. Defaults to "prod" (or "stg" when WALMART_SANDBOX=true). Override only if Walmart support tells you to.
WALMART_SVC_ENV=

# Optional: absolute path for the local seller-profile store. Defaults to
# .walmart-seller-profiles.json in the working directory.
# WALMART_SELLER_PROFILE_STORE=/absolute/path/.walmart-seller-profiles.json
