{
  "name": "walmart-mcp-server",
  "version": "0.4.0",
  "description": "Standalone MCP server for Walmart Marketplace and Walmart Connect seller workflows",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "walmart-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "walmart",
    "marketplace",
    "walmart-connect",
    "seller",
    "ecommerce"
  ],
  "author": "yufakang0826-hue (https://github.com/yufakang0826-hue)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yufakang0826-hue/walmart-listing-mcp.git"
  },
  "homepage": "https://github.com/yufakang0826-hue/walmart-listing-mcp#readme",
  "bugs": {
    "url": "https://github.com/yufakang0826-hue/walmart-listing-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.1",
    "dotenv": "^16.5.0",
    "tsx": "^4.20.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
