{
  "name": "walmart-mcp-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo of MCP servers and shared libraries for Walmart Marketplace (Global API — US, MX, CA, CL).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "servers/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm exec --workspaces -- rm -rf dist"
  },
  "author": "yufakang0826-hue (https://github.com/yufakang0826-hue)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yufakang0826-hue/walmart-listing-mcp.git"
  },
  "homepage": "https://github.com/yufakang0826-hue/walmart-listing-mcp#readme",
  "bugs": {
    "url": "https://github.com/yufakang0826-hue/walmart-listing-mcp/issues"
  }
}
